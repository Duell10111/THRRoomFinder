{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Berlin",
  "platformAutomerge": false,
  "automergeSchedule": ["* 6-11 * * 1"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Merge non-major updates once all checks (incl. E2E) pass; every merge to main deploys, so only on Monday mornings",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Update the Sphinx documentation stack together, including major updates",
      "matchFileNames": ["docs/requirements.txt"],
      "groupName": "documentation dependencies",
      "groupSlug": "documentation-dependencies",
      "separateMajorMinor": false
    },
    {
      "description": "Review Google provider updates separately from application dependencies",
      "matchManagers": ["terraform"],
      "matchPackageNames": ["hashicorp/google"],
      "groupName": "Google provider",
      "groupSlug": "google-provider",
      "automerge": false
    }
  ]
}
